# ============================================
# InvenSync — Environment Variables
# ============================================
# Copy this file to `.env` (local) and configure the same keys in your
# Vercel project settings for production. Never commit real secrets.

# --------------------------------------------
# Database (required)
# --------------------------------------------
# Local development (SQLite):
#   DATABASE_URL="file:./db/custom.db"
# Production (PostgreSQL / Supabase — pooled connection):
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"
DATABASE_URL="file:./db/custom.db"

# Direct (non-pooled) connection — required by Prisma for migrations on
# Supabase/pgbouncer setups. Leave unset for SQLite.
#   DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
# DIRECT_URL=

# --------------------------------------------
# Authentication (required in production)
# --------------------------------------------
# Secret used to sign JWT session tokens and 2FA temp tokens.
# REQUIRED in production — the app throws on boot if unset.
# Generate one with: openssl rand -hex 32
JWT_SECRET="change-me-generate-with-openssl-rand-hex-32"

# --------------------------------------------
# Supabase Auth (optional — enables hosted auth + httpOnly session cookies)
# Leave unset to use the built-in JWT auth fallback.
# --------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# --------------------------------------------
# Protected internal endpoints (set if used)
# --------------------------------------------
# Protects scheduled-report cron endpoints (sent as a bearer/secret header).
CRON_SECRET="change-me"
# Protects the one-time /api/setup/* bootstrap endpoints.
SETUP_SECRET="change-me"

# --------------------------------------------
# AI features (optional — Z.ai SDK). Without these, AI endpoints
# degrade gracefully to non-AI fallbacks.
# --------------------------------------------
# ZAI_BASE_URL=
# ZAI_API_KEY=
# ZAI_CHAT_ID=
# ZAI_TOKEN=
# ZAI_USER_ID=

# --------------------------------------------
# Realtime notification microservice (optional)
# --------------------------------------------
# NOTIFICATION_SERVICE_URL="http://localhost:3003"

# --------------------------------------------
# Misc (optional)
# --------------------------------------------
# Directory for generated export files.
# EXPORT_PATH=
